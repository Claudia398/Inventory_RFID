@model List<CostCenterDTO>

<h2>Cost Center</h2>


<br />
<br />

<table class="table">
    <tr>
        <th>Center</th>
        <th>Actions</th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Center</td>
            <td>
        
         <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning">Edit</a>
                <a asp-action="Delete" asp-route-id="@item.Id"
                   class="btn btn-danger"
                   onclick="return confirm('Sigur vrei să ștergi acest Cost Center?');">
                    Delete
                </a>
   
     </td>
     </tr>
    }
</table>
