@model List<WebApplication1.DTO.NrInventoryDTO>

<h2>Nr Inventory</h2>

<a asp-action="Create" class="btn btn-primary">Add</a>

<table class="table">
    <tr>
        <th>Serial</th>
        <th>Name</th>
        <th>Cost Center</th>
        <th>Sub Inventory</th>
        <th>Actions</th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Serial</td>
            <td>@item.Name</td>
            <td>@item.CostCenterName</td>
            
            <td>
                @if (item.SubInventory != null && item.SubInventory.Any())
                {
                    @string.Join(", ", item.SubInventory.Select(x => x.Name))
                }
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning">Edit</a>
                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger">Delete</a>
                <a class="btn btn-primary" onclick="BeginScan('@item.Id')">Scan RFID</a>
            </td>
        </tr>
    }
</table>


<script>
    // function BeginScan(serialNumber) {
    //     console.log(serialNumber);
        
    // }

@* nou 31.05.2026 *@
let currentInventoryId = 0;

async function BeginScan(id)
{
    currentInventoryId = id;

    const device = await navigator.bluetooth.requestDevice({
        filters: [{ name: 'ESP32_RFID' }],
        optionalServices: [
            '12345678-1234-1234-1234-1234567890ab'
        ]
    });

    const server = await device.gatt.connect();

    const service =
        await server.getPrimaryService(
            '12345678-1234-1234-1234-1234567890ab');

    const characteristic =
        await service.getCharacteristic(
            'abcd1234-5678-5678-5678-abcdef123456');

    await characteristic.startNotifications();

    characteristic.addEventListener(
        'characteristicvaluechanged',
        OnRFIDRead);

    alert("RFID Reader Connected");
}
@* nou 31.05.2026 *@
async function OnRFIDRead(event)
{
    const text =
        new TextDecoder().decode(event.target.value);

    console.log(text);

    const pcMatch =
        text.match(/PC:\s*([0-9A-F ]+)/i);

    const epcMatch =
        text.match(/EPC:\s*([0-9A-F ]+)/i);

    if(!pcMatch || !epcMatch)
        return;

    const pc =
        pcMatch[1].replaceAll(" ", "");

    const epc =
        epcMatch[1].replaceAll(" ", "");

    const rfid = `${pc}/${epc}`;

    console.log(rfid);

    await fetch(
        '/NrInventory/AssignRFIDToInventory',
        {
            method: 'POST',
            headers:
            {
                'Content-Type':
                    'application/x-www-form-urlencoded'
            },
            body:
                `Id=${currentInventoryId}&RFID=${rfid}`
        });

    alert("RFID assigned successfully");
}
</script>