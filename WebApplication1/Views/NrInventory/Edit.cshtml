@model NrInventoryDTO

<h2>Edit NrInventory</h2>

<form asp-action="Edit" method="post">

    <input type="hidden" asp-for="Id" />

    <div class="form-group">
        <label>Serial</label>
        <input asp-for="Serial" class="form-control" />
    </div>

    <div class="form-group">
        <label>Name</label>
        <input asp-for="Name" class="form-control" />
    </div>

    @* <div class="form-group">
        <label>Cost Center</label>
        <input asp-for="CostCenterId" class="form-control" />
    </div> *@
    @* cost center nou *@
    <div class="mb-3">
        <label class="form-label">Cost Center</label>
        <select asp-for="CostCenterId" asp-items="ViewBag.CostCenters" class="form-control"></select>
    </div>
   @*  <div class="form-group">
        <label>SubInventory</label>
       
    </div> *@

 @*   //nou tABEL  *@
    <h4>SubInventory</h4>

    <button type="button" class="btn btn-success mb-2" onclick="addRow()">Add</button>

    <table class="table" id="subInventoryTable">
        <thead>
            <tr>
                <th>Name</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.SubInventory != null)
            {
                for (int i = 0; i < Model.SubInventory.Count; i++)
                {
                    <tr>
                        <td>
                            <input type="hidden" name="SubInventory[@i].Id" value="@Model.SubInventory[i].Id" />
                            <input type="text" name="SubInventory[@i].Name"
                                   value="@Model.SubInventory[i].Name"
                                   class="form-control" />
                        </td>
                        <td>
                            <button type="button" class="btn btn-danger" onclick="removeRow(this)">Delete</button>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
   @*  save *@
    <br />

    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-action="Index" class="btn btn-secondary">Back</a>
            

    @* nou JAVA*@
    <script>
        function addRow() {
            let table = document.getElementById("subInventoryTable").getElementsByTagName('tbody')[0];
            let index = table.rows.length;

            let row = table.insertRow();

            row.innerHTML = `
                <td>
                    <input type="hidden" name="SubInventory[${index}].Id" value="0" />
                    <input type="text" name="SubInventory[${index}].Name" class="form-control" />
                </td>
                <td>
                    <button type="button" class="btn btn-danger" onclick="removeRow(this)">Delete</button>
                </td>
            `;
        }

        function removeRow(btn) {
            let row = btn.closest("tr");
            row.remove();
            reindexTable();
        }

        function reindexTable() {
            let rows = document.querySelectorAll("#subInventoryTable tbody tr");

            rows.forEach((row, index) => {
                row.querySelectorAll("input").forEach(input => {
                    if (input.name.includes("SubInventory")) {
                        if (input.name.includes(".Id")) {
                            input.name = `SubInventory[${index}].Id`;
                        }
                        if (input.name.includes(".Name")) {
                            input.name = `SubInventory[${index}].Name`;
                        }
                    }
                });
            });
        }
    </script>
 
     

</form>